# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=freespace
POSTGRES_USER=freespace
POSTGRES_PASSWORD=change-me

# At least 32 random characters, e.g.: openssl rand -base64 48
JWT_SIGNING_KEY=

# Encrypts storage credentials in the database. Base64 of 32 random bytes: openssl rand -base64 32
# Losing it makes every connected storage account unreadable; keep a backup outside the server.
ENCRYPTION_KEY=

ALLOW_REGISTRATION=true

# Public URL of the web app (OAuth callbacks redirect here). Optional.
FRONTEND_URL=

# Google Drive (optional). Create an OAuth "Web application" client in Google Cloud Console,
# enable the Drive API, and add GOOGLE_REDIRECT_URI as an authorized redirect URI.
# Scopes requested: openid, email, profile, drive.file (only files created by FreeSpace).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/storage-accounts/google/callback

# Allow S3 endpoints on private networks / plain HTTP (e.g. MinIO on your LAN). Keep false if unsure.
S3_ALLOW_PRIVATE_ENDPOINTS=false
S3_ALLOW_INSECURE_ENDPOINTS=false
API_PORT=8080
